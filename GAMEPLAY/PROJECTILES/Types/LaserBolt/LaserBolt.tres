[sub_resource type="Shader" id="1"]
code = "shader_type spatial;
render_mode unshaded, cull_disabled;
varying vec3 faction_tint;
void vertex() { faction_tint = COLOR.rgb; }
void fragment() {
    // Mostly bright neutral energy with a subtle tint from the firing faction.
    vec3 bolt = mix(vec3(0.91, 0.95, 1.0), faction_tint, 0.40);
    ALBEDO = bolt;
    EMISSION = bolt * 0.20;
}
"

